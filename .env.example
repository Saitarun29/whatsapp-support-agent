# All optional. Without GEMINI_API_KEY the app runs in demo mode (deterministic, same JSON contract).
GEMINI_API_KEY=
# Per-call model timeout in ms (default 8000). The agent falls back to demo logic on timeout.
MODEL_TIMEOUT_MS=8000
# Messages per IP per minute, per serverless instance (default 40).
RATE_LIMIT_PER_MIN=40

